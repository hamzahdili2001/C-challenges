#include <unistd.h>

int	ft_isalpha(char c)
{
	if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))
		return (1);
	return (0);
}

void	ft_putchar(char c)
{
	write(1, &c, 1);
}

void	rot13(char *c)
{
	if (*c >= 'm')
		*c = *c - 'a' + 13;
	else if (*c >= 'M')
		*c = *c - 'A' + 13;
	*c = *c - 'a' + 13;
}

int	main(int argc, char *argv[])
{
	char	*str;

	if (argc != 2)
	{
		ft_putchar('\n');
		return (0);
	}
	str = argv[1];
	while (*str)
	{
		if (ft_isalpha(*str))
			rot13(str);
		ft_putchar(*str);
		str++;
	}
	ft_putchar('\n');
	return (0);
}
